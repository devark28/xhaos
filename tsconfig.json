{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true
  },
  "include": [
    "frontend/src"
  ],
  "exclude": [
    "frontend/src/**/*.test.ts"
  ]
}
